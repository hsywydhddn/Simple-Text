# Local model configuration for this project.
# Edit the paths below, then run:
#   source local_config.env

# vLLM is started separately in tmux and exposes an OpenAI-compatible endpoint.
# This is still local-model inference; the endpoint is only the transport.
export OPENAI_API_BASE_URL="http://localhost:6001/v1"

# Set this to the exact id returned by:
#   curl http://localhost:6001/v1/models
# Use either the Gemma or Llama server/model for a run.
export OPENAI_API_MODEL="gemma-2-9b-it"

# Optional label for the active experiment model.
export ACTIVE_LLM_MODEL="gemma"

# Local sentence-transformers model used for exemplar retrieval.
export RETRIEVAL_MODEL="/data/Simple-Text/model/all-MiniLM-L6-v2"

# Local CEFR/readability classifier used by R_base and evaluation.
export READABERT_LOCAL_PATH="/data/Simple-Text/model/readabert-en"

# Local sentence-transformers model used for STS evaluation. 
export STS_LOCAL_PATH="/data/Simple-Text/model/all-MiniLM-L6-v2"

# Local BERTScore model directory.
export BERTSCORE_LOCAL_PATH="/data/Simple-Text/model/roberta-large"

# GPUs visible to vLLM. Use "0" for one GPU or "0,1" for two GPUs.
export CUDA_VISIBLE_DEVICES="0"

# Must match the number of visible GPUs above.
export TENSOR_PARALLEL_SIZE="1"

# Optional defaults for the main experiment.
export IAPS_NUM_CANDIDATES="3"
export IAPS_TEMPERATURE="0.3"
